rt':'\u0938\u0939\u093e\u092f\u0924\u093e \u091a\u093e\u0939\u093f\u090f? \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902','Terms & Conditions':'\u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902','I Agree':'\u092e\u0948\u0902 \u0938\u0939\u092e\u0924 \u0939\u0942\u0902','OTP Not Sent':'\u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u093e \u0917\u092f\u093e','WhatsApp OTP API failed':'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u0910\u092a \u0913\u091f\u0940\u092a\u0940 \u0938\u0947\u0935\u093e \u0935\u093f\u092b\u0932 \u0930\u0939\u0940','Login Failed':'\u0932\u0949\u0917\u093f\u0928 \u0935\u093f\u092b\u0932','Invalid credentials':'\u0905\u092e\u093e\u0928\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940','Network error. Please check your connection.':'\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964','1. Accurate Information':'1. \u0938\u0939\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940','You must provide accurate and complete information during registration.':'\u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0938\u0939\u0940 \u0914\u0930 \u092a\u0942\u0930\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964','2. Location Tracking':'2. \u0938\u094d\u0925\u093e\u0928 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917','Your location will be tracked during work hours for attendance purposes.':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0930\u094d\u092f \u0938\u092e\u092f \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0906\u092a\u0915\u093e \u0938\u094d\u0925\u093e\u0928 \u091f\u094d\u0930\u0948\u0915 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964','3. Data Security':'3. \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e','Your data is secure and not shared with third parties without consent.':'\u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948 \u0914\u0930 \u0938\u0939\u092e\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0938\u0947 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e\u0964','4. Acceptable Use':'4. \u0938\u0939\u0940 \u0909\u092a\u092f\u094b\u0917','You must not misuse the application or attempt unauthorized access.':'\u0906\u092a \u0910\u092a \u0915\u093e \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u092f\u093e \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0947\u0964','5. Account Access':'5. \u0916\u093e\u0924\u0947 \u0915\u0940 \u092a\u0939\u0941\u0902\u091a','Company reserves the right to suspend access for policy violations.':'\u0928\u0940\u0924\u093f \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092a\u0930 \u0915\u0902\u092a\u0928\u0940 \u092a\u0939\u0941\u0902\u091a \u0930\u094b\u0915\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964','6. OTP Confidentiality':'6. \u0913\u091f\u0940\u092a\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e','OTP is confidential and should not be shared with anyone.':'\u0913\u091f\u0940\u092a\u0940 \u0917\u094b\u092a\u0928\u0940\u092f \u0939\u0948 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0938\u0947 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964','7. Agreement':'7. \u0938\u0939\u092e\u0924\u093f','By using this application, you agree to these terms and conditions.':'\u0907\u0938 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0906\u092a \u0907\u0928 \u0928\u093f\u092f\u092e\u094b\u0902 \u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964','Please enter full 4-digit OTP':'\u0915\u0943\u092a\u092f\u093e \u092a\u0942\u0930\u093e 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Invalid OTP':'\u0905\u092e\u093e\u0928\u094d\u092f \u0913\u091f\u0940\u092a\u0940','Something went wrong. Please try again.':'\u0915\u0941\u091b \u0917\u0932\u0924 \u0939\u094b \u0917\u092f\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964',Wait:'\u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902','Please wait':'\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902','seconds before resending':'\u0938\u0947\u0915\u0902\u0921 \u092b\u093f\u0930 \u092d\u0947\u091c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947','OTP resent successfully!':'\u0913\u091f\u0940\u092a\u0940 \u092b\u093f\u0930 \u0938\u0947 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092d\u0947\u091c\u093e \u0917\u092f\u093e!','Failed to resend OTP.':'\u0913\u091f\u0940\u092a\u0940 \u092b\u093f\u0930 \u0938\u0947 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u093e \u091c\u093e \u0938\u0915\u093e\u0964','Enter the 4-digit OTP sent to':'\u092d\u0947\u091c\u0947 \u0917\u090f 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','RESEND OTP':'\u0913\u091f\u0940\u092a\u0940 \u092b\u093f\u0930 \u092d\u0947\u091c\u0947\u0902',RESEND:'\u092b\u093f\u0930 \u092d\u0947\u091c\u0947\u0902','VERIFY OTP':'\u0913\u091f\u0940\u092a\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902',Menu:'\u092e\u0947\u0928\u0942','About us':'\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902','Holiday List':'\u091b\u0941\u091f\u094d\u091f\u0940 \u0938\u0942\u091a\u0940',Logout:'\u0932\u0949\u0917\u0906\u0909\u091f',ToDo:'\u0915\u093e\u0930\u094d\u092f \u0938\u0942\u091a\u0940','Todo List':'\u0915\u093e\u0930\u094d\u092f \u0938\u0942\u091a\u0940','Track assigned tasks, replies, deadlines and status updates.':'\u0938\u094c\u0902\u092a\u0947 \u0917\u090f \u0915\u093e\u0930\u094d\u092f, \u0909\u0924\u094d\u0924\u0930, \u0938\u092e\u092f \u0938\u0940\u092e\u093e \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0905\u092a\u0921\u0947\u091f \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902\u0964','Create New Task':'\u0928\u092f\u093e \u0915\u093e\u0930\u094d\u092f \u092c\u0928\u093e\u090f\u0902','No tasks assigned':'\u0915\u094b\u0908 \u0915\u093e\u0930\u094d\u092f \u0928\u0939\u0940\u0902 \u0938\u094c\u0902\u092a\u093e \u0917\u092f\u093e \u0939\u0948','All your tasks are complete!':'\u0906\u092a\u0915\u0947 \u0938\u092d\u0940 \u0915\u093e\u0930\u094d\u092f \u092a\u0942\u0930\u0947 \u0939\u094b \u091a\u0941\u0915\u0947 \u0939\u0948\u0902!','Send Reply':'\u0909\u0924\u094d\u0924\u0930 \u092d\u0947\u091c\u0947\u0902',Self:'\u0938\u094d\u0935\u092f\u0902','Pending Task':'\u0932\u0902\u092c\u093f\u0924 \u0915\u093e\u0930\u094d\u092f','Checking pending todo':'\u0932\u0902\u092c\u093f\u0924 \u0915\u093e\u0930\u094d\u092f \u091c\u093e\u0902\u091a \u0930\u0939\u0947 \u0939\u0948\u0902','Complete pending todo first':'\u092a\u0939\u0932\u0947 \u0932\u0902\u092c\u093f\u0924 \u0915\u093e\u0930\u094d\u092f \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902','Write your reply here...':'\u0905\u092a\u0928\u093e \u0909\u0924\u094d\u0924\u0930 \u092f\u0939\u093e\u0902 \u0932\u093f\u0916\u0947\u0902...','Update Task':'\u0915\u093e\u0930\u094d\u092f \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902',Deadline:'\u0938\u092e\u092f \u0938\u0940\u092e\u093e','Create Todo':'\u0928\u092f\u093e \u0915\u093e\u0930\u094d\u092f \u092c\u0928\u093e\u090f\u0902','Assign tasks with a deadline and responsible team member.':'\u0938\u092e\u092f \u0938\u0940\u092e\u093e \u0914\u0930 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u091f\u0940\u092e \u0938\u0926\u0938\u094d\u092f \u0915\u0947 \u0938\u093e\u0925 \u0915\u093e\u0930\u094d\u092f \u0938\u094c\u0902\u092a\u0947\u0902\u0964','Create Task':'\u0915\u093e\u0930\u094d\u092f \u0935\u093f\u0935\u0930\u0923','Enter Task':'\u0915\u093e\u0930\u094d\u092f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Job Deadline':'\u0915\u093e\u0930\u094d\u092f \u0915\u0940 \u0938\u092e\u092f \u0938\u0940\u092e\u093e','Select date and time':'\u0926\u093f\u0928\u093e\u0902\u0915 \u0914\u0930 \u0938\u092e\u092f \u091a\u0941\u0928\u0947\u0902','Select HOD':'HOD \u091a\u0941\u0928\u0947\u0902',Single:'\u090f\u0915',Multiple:'\u0905\u0928\u0947\u0915','CREATE TODO':'\u0915\u093e\u0930\u094d\u092f \u092c\u0928\u093e\u090f\u0902','C.Updates':'\u0915\u0902\u092a\u0928\u0940 \u0905\u092a\u0921\u0947\u091f','HR Support':'\u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0938\u0939\u093e\u092f\u0924\u093e',Profile:'\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0935\u093f\u0935\u0930\u0923',History:'\u0907\u0924\u093f\u0939\u093e\u0938','Secure Verification':'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0924\u094d\u092f\u093e\u092a\u0928','Verify your identity to open dashboard':'\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u092a\u0939\u091a\u093e\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902','Face Recognition':'\u091a\u0947\u0939\u0930\u093e \u092a\u0939\u091a\u093e\u0928','Keep your face inside the circle':'\u0905\u092a\u0928\u093e \u091a\u0947\u0939\u0930\u093e \u0917\u094b\u0932\u0947 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0930\u0916\u0947\u0902','Open camera and match face':'\u0915\u0948\u092e\u0930\u093e \u0916\u094b\u0932\u0915\u0930 \u091a\u0947\u0939\u0930\u093e \u092e\u093f\u0932\u093e\u090f\u0902',Fingerprint:'\u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a','Verify phone fingerprint':'\u092b\u094b\u0928 \u0915\u0940 \u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0938\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902',Verified:'\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924','Capturing face...':'\u091a\u0947\u0939\u0930\u093e \u0915\u0948\u092a\u094d\u091a\u0930 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...',Cancel:'\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902','Fingerprint Required':'\u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948','Please set up fingerprint in your phone Settings first, then try again.':'\u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u092b\u094b\u0928 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u091c\u094b\u0921\u093c\u0947\u0902, \u092b\u093f\u0930 \u0926\u094b\u092c\u093e\u0930\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964','Verify your fingerprint':'\u0905\u092a\u0928\u0940 \u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902','Verification Failed':'\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0905\u0938\u092b\u0932','Fingerprint verification was cancelled or failed.':'\u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0930\u0926\u094d\u0926 \u092f\u093e \u0905\u0938\u092b\u0932 \u0939\u094b \u0917\u092f\u093e\u0964','Fingerprint Verified Successfully':'\u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u0941\u0908','Your fingerprint verification is successful.':'\u0906\u092a\u0915\u0940 \u0905\u0902\u0917\u0941\u0932\u0940 \u091b\u093e\u092a \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u092b\u0932 \u0930\u0939\u093e\u0964',Continue:'\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902',Hello:'\u0928\u092e\u0938\u094d\u0924\u0947','Important Notice':'\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0938\u0942\u091a\u0928\u093e','No update available.':'\u0915\u094b\u0908 \u0905\u092a\u0921\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Continue to App':'\u0910\u092a \u092a\u0930 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902','Verification Error':'\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0924\u094d\u0930\u0941\u091f\u093f','Camera Required':'\u0915\u0948\u092e\u0930\u093e \u091c\u0930\u0942\u0930\u0940 \u0939\u0948','Please allow camera permission for face recognition.':'\u091a\u0947\u0939\u0930\u093e \u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u092e\u0930\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964','Camera Not Found':'\u0915\u0948\u092e\u0930\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e','Front camera is not available on this device.':'\u0907\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u092b\u094d\u0930\u0902\u091f \u0915\u0948\u092e\u0930\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Login Required':'\u0932\u0949\u0917\u093f\u0928 \u091c\u0930\u0942\u0930\u0940 \u0939\u0948','Please login again.':'\u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964','Face verify API network failed':'\u091a\u0947\u0939\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0947\u0935\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0905\u0938\u092b\u0932 \u0930\u0939\u093e','Face Verified Successfully':'\u091a\u0947\u0939\u0930\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924','Your face verification is successful.':'\u0906\u092a\u0915\u093e \u091a\u0947\u0939\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u092b\u0932 \u0930\u0939\u093e\u0964','Face Not Verified':'\u091a\u0947\u0939\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906','Face does not match your profile image.':'\u091a\u0947\u0939\u0930\u093e \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0924\u0938\u094d\u0935\u0940\u0930 \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e\u0964','Camera Not Ready':'\u0915\u0948\u092e\u0930\u093e \u0924\u0948\u092f\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948','Please wait a moment and try again.':'\u0915\u0943\u092a\u092f\u093e \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u0930\u0941\u0915\u0915\u0930 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964','Raise queries, chat with assigned HR, HOD, or admin, and track status in one place.':'\u0905\u092a\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902, \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u092f\u093e \u092a\u094d\u0930\u0936\u093e\u0938\u0915 \u0938\u0947 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0926\u0947\u0916\u0947\u0902\u0964','Submit Query':'\u0938\u092e\u0938\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Assigned Support Chats':'\u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924','View assigned user chats and reply in real time.':'\u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924 \u0926\u0947\u0916\u0947\u0902 \u0914\u0930 \u0924\u0941\u0930\u0902\u0924 \u091c\u0935\u093e\u092c \u0926\u0947\u0902\u0964','Assign to':'\u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u0915\u0930\u0947\u0902','Assigned Chats':'\u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u092c\u093e\u0924\u091a\u0940\u0924','Active User Chats':'\u0938\u0915\u094d\u0930\u093f\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924','OPEN CHAT':'\u092c\u093e\u0924\u091a\u0940\u0924 \u0916\u094b\u0932\u0947\u0902','Unknown User':'\u0905\u091c\u094d\u091e\u093e\u0924 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e','No assigned chats yet.':'\u0905\u092d\u0940 \u0915\u094b\u0908 \u0928\u093f\u092f\u0941\u0915\u094d\u0924 \u092c\u093e\u0924\u091a\u0940\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','No previous queries yet.':'\u0905\u092d\u0940 \u0915\u094b\u0908 \u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Select your query':'\u0905\u092a\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u091a\u0941\u0928\u0947\u0902','Select Query Type':'\u0938\u092e\u0938\u094d\u092f\u093e \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902',Remark:'\u091f\u093f\u092a\u094d\u092a\u0923\u0940','Enter your remark':'\u0905\u092a\u0928\u0940 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0932\u093f\u0916\u0947\u0902','Add supporting attachment if required.':'\u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u094b \u0924\u094b \u0938\u0939\u093e\u092f\u0915 \u092b\u093e\u0907\u0932 \u091c\u094b\u0921\u093c\u0947\u0902\u0964',Add:'\u091c\u094b\u0921\u093c\u0947\u0902','Image attached':'\u0924\u0938\u094d\u0935\u0940\u0930 \u091c\u0941\u0921\u093c \u0917\u0908 \u0939\u0948','SUBMIT QUERY':'\u0938\u092e\u0938\u094d\u092f\u093e \u092d\u0947\u091c\u0947\u0902','Your HR query has been submitted.':'\u0906\u092a\u0915\u0940 \u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0938\u092e\u0938\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u0908 \u0939\u0948\u0964','Previous Queries':'\u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0902',Attachment:'\u0938\u0902\u0932\u0917\u094d\u0928\u0915','CHAT WITH':'\u092c\u093e\u0924 \u0915\u0930\u0947\u0902','HR Support Chat':'\u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924','Chat directly with our support team in real-time.':'\u0939\u092e\u093e\u0930\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u091f\u0940\u092e \u0938\u0947 \u0938\u0940\u0927\u0947 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u092e\u0947\u0902 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930\u0947\u0902\u0964','Support Chat':'\u0938\u0939\u093e\u092f\u0924\u093e \u092c\u093e\u0924\u091a\u0940\u0924','Assigned to':'\u0928\u093f\u092f\u0941\u0915\u094d\u0924','Type your message':'\u0905\u092a\u0928\u093e \u0938\u0902\u0926\u0947\u0936 \u0932\u093f\u0916\u0947\u0902',Send:'\u092d\u0947\u091c\u0947\u0902',Back:'\u0935\u093e\u092a\u0938',You:'\u0906\u092a','Message Failed':'\u0938\u0902\u0926\u0947\u0936 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u093e \u0917\u092f\u093e','Please try again':'\u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902',Error:'\u0924\u094d\u0930\u0941\u091f\u093f','Failed to send message':'\u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0908','No Internet Connection':'\u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948','Please check your Wi-Fi or Mobile Data connection.':'\u0915\u0943\u092a\u092f\u093e \u0935\u093e\u0908-\u092b\u093e\u0908 \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964',Retry:'\u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902','Crewcam Service Menu':'\u0915\u094d\u0930\u0942\u0915\u0948\u092e \u0938\u0947\u0935\u093e \u092e\u0947\u0928\u0942','Attendance Management':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u092a\u094d\u0930\u092c\u0902\u0927\u0928','Mark, view, and manage team attendance effortlessly.':'\u091f\u0940\u092e \u0915\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902, \u0926\u0947\u0916\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964','Leave Management':'\u0905\u0935\u0915\u093e\u0936 \u092a\u094d\u0930\u092c\u0902\u0927\u0928','Apply for leaves and track request status.':'\u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0947\u0916\u0947\u0902\u0964','Meeting & Site Visit':'\u092c\u0948\u0920\u0915 \u0914\u0930 \u0938\u094d\u0925\u0932 \u092d\u094d\u0930\u092e\u0923','Schedule meetings and log site visit details.':'\u092c\u0948\u0920\u0915\u0947\u0902 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u0925\u0932 \u092d\u094d\u0930\u092e\u0923 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964','Employee Live Tracking':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0938\u0940\u0927\u093e \u0938\u094d\u0925\u093e\u0928 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917','Monitor employee live location':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093e \u0938\u0940\u0927\u093e \u0938\u094d\u0925\u093e\u0928 \u0926\u0947\u0916\u0947\u0902',Tracking:'\u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917','Live field tracking':'\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0915\u0940 \u0938\u0940\u0927\u0940 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917','Master Eye':'\u092e\u0941\u0916\u094d\u092f \u0928\u093f\u0917\u0930\u093e\u0928\u0940','View master admin controls':'\u092e\u0941\u0916\u094d\u092f \u092a\u094d\u0930\u0936\u093e\u0938\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0926\u0947\u0916\u0947\u0902','Choose Action':'\u0915\u093e\u0930\u094d\u092f \u091a\u0941\u0928\u0947\u0902','Daily Attendance':'\u0926\u0948\u0928\u093f\u0915 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f','Check in, check out and mark atten...':'\u0906\u0917\u092e\u0928, \u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902...','Attendance Status':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u0925\u093f\u0924\u093f','View current and past attendance s...':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0914\u0930 \u092a\u093f\u091b\u0932\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0947\u0916\u0947\u0902...','Leave Request':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927','Apply and track leave requests':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0947\u0916\u0947\u0902','Manage meetings, MoMs and site visits from one place.':'\u092c\u0948\u0920\u0915\u0947\u0902, \u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u0914\u0930 \u0938\u094d\u0925\u0932 \u092d\u094d\u0930\u092e\u0923 \u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u0938\u0947 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964','Add New Meeting':'\u0928\u0908 \u092c\u0948\u0920\u0915 \u091c\u094b\u0921\u093c\u0947\u0902','Create a meeting with client and agenda details.':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f\u0938\u0942\u091a\u0940 \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0948\u0920\u0915 \u092c\u0928\u093e\u090f\u0902\u0964','Scheduled Meeting':'\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u092c\u0948\u0920\u0915','Review upcoming meetings and planned visits.':'\u0906\u0917\u093e\u092e\u0940 \u092c\u0948\u0920\u0915\u094b\u0902 \u0914\u0930 \u0928\u093f\u092f\u094b\u091c\u093f\u0924 \u092d\u094d\u0930\u092e\u0923\u094b\u0902 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964',"Create MoM's":'\u092c\u0948\u0920\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u092c\u0928\u093e\u090f\u0902','Capture discussion notes and action points.':'\u091a\u0930\u094d\u091a\u093e \u091f\u093f\u092a\u094d\u092a\u0923\u093f\u092f\u093e\u0902 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f \u092c\u093f\u0902\u0926\u0941 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964','Meeting History':'\u092c\u0948\u0920\u0915 \u0907\u0924\u093f\u0939\u093e\u0938','Select Meeting Type':'\u092c\u0948\u0920\u0915 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902','Choose between a local meeting or an outstation meeting to proceed.':'\u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092c\u0948\u0920\u0915 \u092f\u093e \u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u092c\u0948\u0920\u0915 \u091a\u0941\u0928\u0947\u0902\u0964',OR:'\u092f\u093e','Local Meeting':'\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092c\u0948\u0920\u0915','Outstation Meeting':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u092c\u0948\u0920\u0915','NEW CLIENT':'\u0928\u092f\u093e \u0917\u094d\u0930\u093e\u0939\u0915','EXISTING CLIENT':'\u092e\u094c\u091c\u0942\u0926\u093e \u0917\u094d\u0930\u093e\u0939\u0915','Before going out for the Local meeting, please write full details of the questions below:':'\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092c\u0948\u0920\u0915 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u093e \u092a\u0942\u0930\u093e \u0935\u093f\u0935\u0930\u0923 \u0932\u093f\u0916\u0947\u0902:','Before going out for the Outstation meeting, please write full details of the questions below:':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u092c\u0948\u0920\u0915 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u093e \u092a\u0942\u0930\u093e \u0935\u093f\u0935\u0930\u0923 \u0932\u093f\u0916\u0947\u0902:','Add Client Details':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0935\u093f\u0935\u0930\u0923 \u091c\u094b\u0921\u093c\u0947\u0902','Search Client':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0916\u094b\u091c\u0947\u0902','Search for an existing client...':'\u092e\u094c\u091c\u0942\u0926\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u0916\u094b\u091c\u0947\u0902...','Add New Client':'\u0928\u092f\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u091c\u094b\u0921\u093c\u0947\u0902','Client Name':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u0928\u093e\u092e','Enter client name':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Contact Person':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f','Contact Person Name':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u0928\u093e\u092e','Enter contact person name':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Enter designation':'\u092a\u0926\u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Mobile No.':'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930','Enter mobile number':'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Enter alternate number':'\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Client Address':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u092a\u0924\u093e','Enter client address':'\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Select City':'\u0936\u0939\u0930 \u091a\u0941\u0928\u0947\u0902','Search for a city...':'\u0936\u0939\u0930 \u0916\u094b\u091c\u0947\u0902...','Select Location':'\u0938\u094d\u0925\u093e\u0928 \u091a\u0941\u0928\u0947\u0902','Search for a location...':'\u0938\u094d\u0925\u093e\u0928 \u0916\u094b\u091c\u0947\u0902...','Pin Code':'\u092a\u093f\u0928 \u0915\u094b\u0921',City:'\u0936\u0939\u0930',Location:'\u0938\u094d\u0925\u093e\u0928','Pin Code No.':'\u092a\u093f\u0928 \u0915\u094b\u0921 \u0928\u0902\u092c\u0930','Enter pin code':'\u092a\u093f\u0928 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Email ID':'\u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940','Enter email':'\u0908\u092e\u0947\u0932 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Add Meeting Details':'\u092c\u0948\u0920\u0915 \u0935\u093f\u0935\u0930\u0923 \u091c\u094b\u0921\u093c\u0947\u0902','Meeting Date':'\u092c\u0948\u0920\u0915 \u0924\u093e\u0930\u0940\u0916','Meeting Time':'\u092c\u0948\u0920\u0915 \u0938\u092e\u092f','Departure Date':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0924\u093e\u0930\u0940\u0916','Return Date':'\u0935\u093e\u092a\u0938\u0940 \u0924\u093e\u0930\u0940\u0916','Meeting Agenda':'\u092c\u0948\u0920\u0915 \u0915\u093e\u0930\u094d\u092f\u0938\u0942\u091a\u0940','Enter meeting agenda':'\u092c\u0948\u0920\u0915 \u0915\u093e\u0930\u094d\u092f\u0938\u0942\u091a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',SAVE:'\u0938\u0939\u0947\u091c\u0947\u0902',RESET:'\u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902',Saved:'\u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e','Meeting saved successfully.':'\u092c\u0948\u0920\u0915 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908\u0964','Outstation meeting saved successfully.':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u092c\u0948\u0920\u0915 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908\u0964','Failed to save meeting':'\u092c\u0948\u0920\u0915 \u0938\u0939\u0947\u091c\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0940','Connection failed. Please try again.':'\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964','Missing fields':'\u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u0927\u0942\u0930\u0940 \u0939\u0948','Please fill':'\u0915\u0943\u092a\u092f\u093e \u092d\u0930\u0947\u0902','You can see the details of the meeting minutes (MOM) by clicking on the items below.':'\u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u0906\u0907\u091f\u092e \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0906\u092a \u092c\u0948\u0920\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964','Meeting History & MoM List':'\u092c\u0948\u0920\u0915 \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u0938\u0942\u091a\u0940',Status:'\u0938\u094d\u0925\u093f\u0924\u093f','MoM Added':'\u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u091c\u094b\u0921\u093c\u093e \u0917\u092f\u093e','No meeting history found.':'\u092c\u0948\u0920\u0915 \u0907\u0924\u093f\u0939\u093e\u0938 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964','You can reset the meeting time and date details by clicking the edit icon':'\u0938\u0902\u092a\u093e\u0926\u0928 \u0906\u0907\u0915\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0906\u092a \u092c\u0948\u0920\u0915 \u0915\u093e \u0938\u092e\u092f \u0914\u0930 \u0924\u093e\u0930\u0940\u0916 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964','Scheduled Meeting List':'\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u092c\u0948\u0920\u0915 \u0938\u0942\u091a\u0940','Unnamed Client':'\u0928\u093e\u092e \u0930\u0939\u093f\u0924 \u0917\u094d\u0930\u093e\u0939\u0915',Contact:'\u0938\u0902\u092a\u0930\u094d\u0915','Tap to view details':'\u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902','No meetings scheduled for today.':'\u0906\u091c \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092c\u0948\u0920\u0915 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','No upcoming meetings scheduled.':'\u0915\u094b\u0908 \u0906\u0917\u093e\u092e\u0940 \u092c\u0948\u0920\u0915 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Your schedule is clear right now.':'\u0905\u092d\u0940 \u0906\u092a\u0915\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0916\u093e\u0932\u0940 \u0939\u0948\u0964','Meeting details not found.':'\u092c\u0948\u0920\u0915 \u0935\u093f\u0935\u0930\u0923 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964','Meeting updated successfully.':'\u092c\u0948\u0920\u0915 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0921\u0947\u091f \u0939\u0941\u0908\u0964','Meeting deleted successfully.':'\u092c\u0948\u0920\u0915 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0939\u091f\u093e\u0908 \u0917\u0908\u0964','View previous meetings and MoM records.':'\u092a\u093f\u091b\u0932\u0940 \u092c\u0948\u0920\u0915\u094b\u0902 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f\u0935\u0943\u0924\u094d\u0924 \u0905\u092d\u093f\u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0926\u0947\u0916\u0947\u0902\u0964','Add Site Visit':'\u0938\u094d\u0925\u0932 \u092d\u094d\u0930\u092e\u0923 \u091c\u094b\u0921\u093c\u0947\u0902','Log a site visit with location and purpose.':'\u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0925\u0932 \u092d\u094d\u0930\u092e\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',Office:'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f',Personal:'\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924',Account:'\u0916\u093e\u0924\u093e',Score:'\u0905\u0902\u0915','Full Name':'\u092a\u0942\u0930\u093e \u0928\u093e\u092e','Unique ID':'\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u0939\u091a\u093e\u0928 \u0938\u0902\u0916\u094d\u092f\u093e','Designation & Grade':'\u092a\u0926\u0928\u093e\u092e \u0914\u0930 \u0917\u094d\u0930\u0947\u0921',Department:'\u0935\u093f\u092d\u093e\u0917','Office Cell No.':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930','Official Email ID':'\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940','Reporting Boss':'\u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0905\u0927\u093f\u0915\u093e\u0930\u0940','Contact No.':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930','Job Reporting Address':'\u0915\u093e\u0930\u094d\u092f \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u092a\u0924\u093e','Joining Date':'\u091c\u094d\u0935\u093e\u0907\u0928\u093f\u0902\u0917 \u0924\u093f\u0925\u093f','Appraisal Month':'\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u092e\u093e\u0939','Personal Cell No.':'\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930','Residence No.':'\u0928\u093f\u0935\u093e\u0938 \u0928\u0902\u092c\u0930','Residence Address':'\u0928\u093f\u0935\u093e\u0938 \u092a\u0924\u093e','Emergency Details':'\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0935\u093f\u0935\u0930\u0923',Name:'\u0928\u093e\u092e',Relation:'\u0938\u0902\u092c\u0902\u0927','Cell No.':'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930','Alternate No.':'\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0928\u0902\u092c\u0930',Email:'\u0908\u092e\u0947\u0932','Contact Address':'\u0938\u0902\u092a\u0930\u094d\u0915 \u092a\u0924\u093e','Salary Bank Account No.':'\u0935\u0947\u0924\u0928 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e','IFSC Code':'\u0906\u0908\u090f\u092b\u090f\u0938\u0938\u0940 \u0915\u094b\u0921','Personal Bank Account No.':'\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e','Paytm No.':'\u092a\u0947\u091f\u0940\u090f\u092e \u0928\u0902\u092c\u0930','Health Insurance':'\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092c\u0940\u092e\u093e','Aadhar Card No.':'\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930','Passport No.':'\u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f \u0928\u0902\u092c\u0930','PAN Card No.':'\u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930','ESIC No.':'\u0908\u090f\u0938\u0906\u0908\u0938\u0940 \u0928\u0902\u092c\u0930','EPF No.':'\u0908\u092a\u0940\u090f\u092b \u0928\u0902\u092c\u0930','Score Parameters':'\u0905\u0902\u0915 \u092e\u093e\u0928\u0926\u0902\u0921','Work Attendence':'\u0915\u093e\u0930\u094d\u092f \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f','Ambition / Initiative':'\u092e\u0939\u0924\u094d\u0935\u093e\u0915\u093e\u0902\u0915\u094d\u0937\u093e / \u092a\u0939\u0932','Productivity / Deadline':'\u0909\u0924\u094d\u092a\u093e\u0926\u0915\u0924\u093e / \u0938\u092e\u092f\u0938\u0940\u092e\u093e','Quality of Work':'\u0915\u093e\u0930\u094d\u092f \u0915\u0940 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e','Focus Towards Task':'\u0915\u093e\u0930\u094d\u092f \u092a\u0930 \u0927\u094d\u092f\u093e\u0928','Stress Managmnt':'\u0924\u0928\u093e\u0935 \u092a\u094d\u0930\u092c\u0902\u0927\u0928','Reliability / Dependability':'\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\u0924\u093e / \u0928\u093f\u0930\u094d\u092d\u0930\u0924\u093e',Achievments:'\u0909\u092a\u0932\u092c\u094d\u0927\u093f\u092f\u093e\u0902','Level Of Work Knowledge':'\u0915\u093e\u0930\u094d\u092f \u091c\u094d\u091e\u093e\u0928 \u0915\u093e \u0938\u094d\u0924\u0930','Company Oriented':'\u0915\u0902\u092a\u0928\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924','Attitude / Co-operations':'\u0935\u094d\u092f\u0935\u0939\u093e\u0930 / \u0938\u0939\u092f\u094b\u0917','Communication Skills':'\u0938\u0902\u091a\u093e\u0930 \u0915\u094c\u0936\u0932','Team Work / Piching - In':'\u091f\u0940\u092e \u0915\u093e\u0930\u094d\u092f / \u0938\u0939\u092f\u094b\u0917','Integrity / Dedication':'\u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 / \u0938\u092e\u0930\u094d\u092a\u0923','Activity Logs':'\u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0905\u092d\u093f\u0932\u0947\u0916',"Today's attendance, leave and task activity.":'\u0906\u091c \u0915\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f, \u0905\u0935\u0915\u093e\u0936 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u0964','No Activity Logs':'\u0915\u094b\u0908 \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0905\u092d\u093f\u0932\u0947\u0916 \u0928\u0939\u0940\u0902','Nothing to show yet.':'\u0905\u092d\u0940 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Company Updates':'\u0915\u0902\u092a\u0928\u0940 \u0905\u092a\u0921\u0947\u091f','Current month notifications and personal occasions.':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u093e\u0939 \u0915\u0940 \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0914\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0905\u0935\u0938\u0930\u0964','No Updates':'\u0915\u094b\u0908 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902','There are no notifications for this month.':'\u0907\u0938 \u092e\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0938\u0942\u091a\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964',Birthday:'\u091c\u0928\u094d\u092e\u0926\u093f\u0928','Marriage Anniversary':'\u0935\u093f\u0935\u093e\u0939 \u0935\u0930\u094d\u0937\u0917\u093e\u0902\u0920','Wish Received':'\u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0908','Wish Sent':'\u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e \u092d\u0947\u091c\u0940 \u0917\u0908','Company Update':'\u0915\u0902\u092a\u0928\u0940 \u0905\u092a\u0921\u0947\u091f','Birthday Celebration':'\u091c\u0928\u094d\u092e\u0926\u093f\u0928 \u0938\u092e\u093e\u0930\u094b\u0939','Anniversary Celebration':'\u0935\u0930\u094d\u0937\u0917\u093e\u0902\u0920 \u0938\u092e\u093e\u0930\u094b\u0939','Happy Birthday':'\u091c\u0928\u094d\u092e\u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u090f\u0902','Wished by':'\u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947',By:'\u0926\u094d\u0935\u093e\u0930\u093e',Noted:'\u0926\u0947\u0916 \u0932\u093f\u092f\u093e','Send Wish':'\u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e \u092d\u0947\u091c\u0947\u0902',"Today's Notifications":'\u0906\u091c \u0915\u0940 \u0938\u0942\u091a\u0928\u093e\u090f\u0902','Please check all notifications before continuing!':'\u0915\u0943\u092a\u092f\u093e \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u092d\u0940 \u0938\u0942\u091a\u0928\u093e\u0913\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902!','No updates available':'\u0915\u094b\u0908 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948','Open all updates':'\u0938\u092d\u0940 \u0905\u092a\u0921\u0947\u091f \u0916\u094b\u0932\u0947\u0902','request by':'\u0905\u0928\u0941\u0930\u094b\u0927\u0915\u0930\u094d\u0924\u093e',Someone:'\u0915\u094b\u0908 \u0935\u094d\u092f\u0915\u094d\u0924\u093f',Regards:'\u0938\u093e\u0926\u0930','Select Month':'\u092e\u093e\u0939 \u091a\u0941\u0928\u0947\u0902','Attendance Score':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0905\u0902\u0915',Date:'\u0924\u093e\u0930\u0940\u0916',Intime:'\u0906\u0917\u092e\u0928 \u0938\u092e\u092f',Outime:'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0938\u092e\u092f',User:'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e',To:'\u0915\u094b',Leave:'\u0905\u0935\u0915\u093e\u0936','No Data Available For This Month.':'\u0907\u0938 \u092e\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964','Attendance Name':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0928\u093e\u092e',Code:'\u0915\u094b\u0921','Nos.':'\u0938\u0902\u0916\u094d\u092f\u093e',Rule:'\u0928\u093f\u092f\u092e',Days:'\u0926\u093f\u0928','Application crashed issue':'\u0910\u092a \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e','Location not detected':'\u0938\u094d\u0925\u093e\u0928 \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u091a\u0932 \u0930\u0939\u093e','Attendance punch not working':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u092a\u0902\u091a \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e','Attendance status not shown':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u0925\u093f\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u093f\u0916 \u0930\u0939\u0940','Attendance history issue':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e','Live location not working':'\u0938\u0940\u0927\u093e \u0938\u094d\u0925\u093e\u0928 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e','Request not going':'\u0905\u0928\u0941\u0930\u094b\u0927 \u0928\u0939\u0940\u0902 \u091c\u093e \u0930\u0939\u093e','Approvals cannot be given':'\u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0940 \u091c\u093e \u0930\u0939\u0940','Login issue':'\u0932\u0949\u0917\u093f\u0928 \u0938\u092e\u0938\u094d\u092f\u093e','Password reset':'\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f',Other:'\u0905\u0928\u094d\u092f',Pending:'\u0932\u0902\u092c\u093f\u0924',Completed:'\u092a\u0942\u0930\u093e \u0939\u0941\u0906',Overdue:'\u0926\u0947\u0930\u0940 \u0938\u0947','In Progress':'\u092a\u094d\u0930\u0917\u0924\u093f \u092e\u0947\u0902',Resolved:'\u0938\u092e\u093e\u0927\u093e\u0928 \u0939\u094b \u0917\u092f\u093e','Here Is Your Monthly Presence Details. If You Have Any Discrepancy Regarding Details, Please Contact The Hr Department For Amendment.':'\u092f\u0939 \u0906\u092a\u0915\u0947 \u092e\u093e\u0938\u093f\u0915 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0935\u093f\u0935\u0930\u0923 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0935\u093f\u0935\u0930\u0923 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0905\u0902\u0924\u0930 \u0939\u094b, \u0924\u094b \u0938\u0941\u0927\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u0928\u0935 \u0938\u0902\u0938\u093e\u0927\u0928 \u0935\u093f\u092d\u093e\u0917 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964','Present Days':'\u0909\u092a\u0938\u094d\u0925\u093f\u0924 \u0926\u093f\u0928','Late Coming':'\u0926\u0947\u0930 \u0938\u0947 \u0906\u0917\u092e\u0928','Week Off-Present':'\u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0905\u0935\u0915\u093e\u0936 \u092a\u0930 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f','Week Off Days':'\u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0905\u0935\u0915\u093e\u0936 \u0926\u093f\u0928','Holiday Present':'\u091b\u0941\u091f\u094d\u091f\u0940 \u092a\u0930 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f','Holiday Days':'\u091b\u0941\u091f\u094d\u091f\u0940 \u0915\u0947 \u0926\u093f\u0928','Absent Days':'\u0905\u0928\u0941\u092a\u0938\u094d\u0925\u093f\u0924 \u0926\u093f\u0928','Office Leave':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0905\u0935\u0915\u093e\u0936','Paid Leave':'\u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936','Monthly Ctc':'\u092e\u093e\u0938\u093f\u0915 \u0938\u0940\u091f\u0940\u0938\u0940','Earn Ctc':'\u0905\u0930\u094d\u091c\u093f\u0924 \u0938\u0940\u091f\u0940\u0938\u0940','Gross Salary':'\u0938\u0915\u0932 \u0935\u0947\u0924\u0928','Esi Contribution':'\u0908\u090f\u0938\u0906\u0908 \u092f\u094b\u0917\u0926\u093e\u0928','Pf Contribution':'\u092a\u0940\u090f\u092b \u092f\u094b\u0917\u0926\u093e\u0928','Ot Salary':'\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u092e\u092f \u0935\u0947\u0924\u0928','Incentive Amt.':'\u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u0928 \u0930\u093e\u0936\u093f','Earned Salary':'\u0905\u0930\u094d\u091c\u093f\u0924 \u0935\u0947\u0924\u0928','Tds Deduction':'\u091f\u0940\u0921\u0940\u090f\u0938 \u0915\u091f\u094c\u0924\u0940','Loan Installment':'\u090b\u0923 \u0915\u093f\u0938\u094d\u0924','Adv. For Expense':'\u0916\u0930\u094d\u091a \u0939\u0947\u0924\u0941 \u0905\u0917\u094d\u0930\u093f\u092e','Expense Received':'\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0916\u0930\u094d\u091a \u0930\u093e\u0936\u093f','Adv. Sal. Deduction':'\u0905\u0917\u094d\u0930\u093f\u092e \u0935\u0947\u0924\u0928 \u0915\u091f\u094c\u0924\u0940','Penalty Deduction':'\u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e \u0915\u091f\u094c\u0924\u0940','Net Payable Salary':'\u0926\u0947\u092f \u0936\u0941\u0926\u094d\u0927 \u0935\u0947\u0924\u0928','Loan Balance':'\u090b\u0923 \u0936\u0947\u0937','Check In':'\u0906\u0917\u092e\u0928 \u0926\u0930\u094d\u091c','Check Out':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c','Office In':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936','Office Out':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930','Office Out Approved':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0938\u094d\u0935\u0940\u0915\u0943\u0924','Office Out Rejected':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924','Urgent Leave':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936','Casual Leave':'\u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0905\u0935\u0915\u093e\u0936','Outstation Leave':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u0905\u0935\u0915\u093e\u0936','Please enter your leave reason':'\u0915\u0943\u092a\u092f\u093e \u0905\u0935\u0915\u093e\u0936 \u0915\u093e \u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Invalid Date':'\u0905\u092e\u093e\u0928\u094d\u092f \u0924\u093e\u0930\u0940\u0916','You cannot apply Paid Leave for today or a previous date. Please select tomorrow or a future date.':'\u0906\u091c \u092f\u093e \u092a\u093f\u091b\u0932\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u0947 \u0932\u093f\u090f \u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0915\u0932 \u092f\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u091a\u0941\u0928\u0947\u0902\u0964','You cannot apply leave for today or a previous date. Please select tomorrow or a future date.':'\u0906\u091c \u092f\u093e \u092a\u093f\u091b\u0932\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u0947 \u0932\u093f\u090f \u0905\u0935\u0915\u093e\u0936 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0915\u0932 \u092f\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u091a\u0941\u0928\u0947\u0902\u0964','User not authenticated':'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948','Leave submitted successfully.':'\u0905\u0935\u0915\u093e\u0936 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e\u0964','Failed to submit leave':'\u0905\u0935\u0915\u093e\u0936 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e','Failed to send leave request':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0908','Please write your reason below as to why you are requesting Paid Leave.':'\u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u0947\u0902\u0964','PAID LEAVE REQUEST':'\u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927','Select Leave Date *':'\u0905\u0935\u0915\u093e\u0936 \u0924\u093e\u0930\u0940\u0916 \u091a\u0941\u0928\u0947\u0902 *','Please write your reason...':'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0932\u093f\u0916\u0947\u0902...','Location permission denied':'\u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924','Unable to fetch location':'\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e','Please select leave type and enter reason.':'\u0915\u0943\u092a\u092f\u093e \u0905\u0935\u0915\u093e\u0936 \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964','Fetching location. Please wait...':'\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902...','Please write your reason below as to why you are requesting Urgent Leave.':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u0947\u0902\u0964','Checking urgent leave options...':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0935\u093f\u0915\u0932\u094d\u092a \u091c\u093e\u0902\u091a\u0947 \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902...','Urgent leave options are not available at this time.':'\u0907\u0938 \u0938\u092e\u092f \u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0935\u093f\u0915\u0932\u094d\u092a \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964','URGENT LEAVE REQUEST':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927',Coordinates:'\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915','Please select an employee.':'\u0915\u0943\u092a\u092f\u093e \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u091a\u0941\u0928\u0947\u0902\u0964','Location not available yet. Please wait.':'\u0938\u094d\u0925\u093e\u0928 \u0905\u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964','Token missing. Please login again.':'\u091f\u094b\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964','Invalid employee selection.':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u091a\u092f\u0928 \u0905\u092e\u093e\u0928\u094d\u092f \u0939\u0948\u0964','Leave Request Sent!':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e!','Unknown error':'\u0905\u091c\u094d\u091e\u093e\u0924 \u0924\u094d\u0930\u0941\u091f\u093f','Error sending leave request':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f','Please write your reason below as to why you are requesting Casual Leave.':'\u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u0947\u0902\u0964','CASUAL LEAVE REQUEST':'\u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927','Leave start date *':'\u0905\u0935\u0915\u093e\u0936 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 *','Leave end date *':'\u0905\u0935\u0915\u093e\u0936 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093e\u0930\u0940\u0916 *','Please Provide a Reason For Your Casual Leave? *':'\u0915\u0943\u092a\u092f\u093e \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0905\u0935\u0915\u093e\u0936 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0902 *','Enter your reason':'\u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Who Has Taken Responsibility For Work During Your Leaves?':'\u0906\u092a\u0915\u0947 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u093e\u092e \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0915\u093f\u0938\u0928\u0947 \u0932\u0940 \u0939\u0948?','Who Has Taken Responsibility For Work During Your Leaves ?':'\u0906\u092a\u0915\u0947 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u093e\u092e \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0915\u093f\u0938\u0928\u0947 \u0932\u0940 \u0939\u0948?','Employee Name':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093e \u0928\u093e\u092e',Designation:'\u092a\u0926\u0928\u093e\u092e','Select Employee':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u091a\u0941\u0928\u0947\u0902','SENDING...':'\u092d\u0947\u091c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...',SEND:'\u092d\u0947\u091c\u0947\u0902','Fetching current location...':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...','Current Location:':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093e\u0928:','Please fill all required (*) fields.':'\u0915\u0943\u092a\u092f\u093e \u0938\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 (*) \u092b\u093c\u0940\u0932\u094d\u0921 \u092d\u0930\u0947\u0902\u0964','Outstation Leave request submitted successfully!':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e!','Failed to submit request.':'\u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964','An error occurred while submitting.':'\u091c\u092e\u093e \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908\u0964','Please write your reason below as to why you are requesting Outstation Leave.':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u0947\u0902\u0964','OUTSTATION LEAVE REQUEST':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927','Please Provide a Reason For Your Outstation Leave *':'\u0915\u0943\u092a\u092f\u093e \u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u0905\u0935\u0915\u093e\u0936 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0902 *','Enter reason':'\u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Your Address And Contact Details During Leaves ?*':'\u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0906\u092a\u0915\u093e \u092a\u0924\u093e \u0914\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923 ?*','Address during your leave *':'\u0905\u0935\u0915\u093e\u0936 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092a\u0924\u093e *','Enter address':'\u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Country *':'\u0926\u0947\u0936 *','State *':'\u0930\u093e\u091c\u094d\u092f *','Select State':'\u0930\u093e\u091c\u094d\u092f \u091a\u0941\u0928\u0947\u0902','City *':'\u0936\u0939\u0930 *','Pincode *':'\u092a\u093f\u0928 \u0915\u094b\u0921 *',Pincode:'\u092a\u093f\u0928 \u0915\u094b\u0921','Contact No. *':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930 *','Enter contact number':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Relation with contact no. *':'\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927 *','Leave Approved':'\u0905\u0935\u0915\u093e\u0936 \u0938\u094d\u0935\u0940\u0915\u0943\u0924','Leave Rejected':'\u0905\u0935\u0915\u093e\u0936 \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924','Good Morning':'\u0938\u0941\u092a\u094d\u0930\u092d\u093e\u0924','Good morning':'\u0938\u0941\u092a\u094d\u0930\u092d\u093e\u0924',GoodMorning:'\u0938\u0941\u092a\u094d\u0930\u092d\u093e\u0924','Good Afternoon':'\u0928\u092e\u0938\u094d\u0915\u093e\u0930','Good afternoon':'\u0928\u092e\u0938\u094d\u0915\u093e\u0930',GoodAfternoon:'\u0928\u092e\u0938\u094d\u0915\u093e\u0930','Good Evening':'\u0936\u0941\u092d \u0938\u0902\u0927\u094d\u092f\u093e','Good evening':'\u0936\u0941\u092d \u0938\u0902\u0927\u094d\u092f\u093e',GoodEvening:'\u0936\u0941\u092d \u0938\u0902\u0927\u094d\u092f\u093e',Hi:'\u0928\u092e\u0938\u094d\u0924\u0947',Username:'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e','User Name':'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e','Current Time':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u092e\u092f','Current Location':'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093e\u0928','Loading location...':'\u0938\u094d\u0925\u093e\u0928 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...','Fetching location...':'\u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...','Fetching address...':'\u092a\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...','Address not available':'\u092a\u0924\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948','Address found but fields empty':'\u092a\u0924\u093e \u092e\u093f\u0932\u093e, \u0932\u0947\u0915\u093f\u0928 \u0935\u093f\u0935\u0930\u0923 \u0916\u093e\u0932\u0940 \u0939\u0948\u0902','Company premises address not set':'\u0915\u0902\u092a\u0928\u0940 \u092a\u0930\u093f\u0938\u0930 \u0915\u093e \u092a\u0924\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948','Permission Denied':'\u0905\u0928\u0941\u092e\u0924\u093f \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924','Location permission is required.':'\u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964','Location access is required to check in.':'\u0906\u0917\u092e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964','Location access is required to check out.':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964','Location access is required.':'\u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964','Missing token or location':'\u0932\u0949\u0917\u093f\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092f\u093e \u0938\u094d\u0925\u093e\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948',Success:'\u0938\u092b\u0932',Failed:'\u0905\u0938\u092b\u0932','Check-In successful!':'\u0906\u0917\u092e\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u092f\u093e!','Check-In failed':'\u0906\u0917\u092e\u0928 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e','Network request failed. Please check your connection.':'\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u0938\u092b\u0932 \u0930\u0939\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964','Confirm your time and location':'\u0905\u092a\u0928\u093e \u0938\u092e\u092f \u0914\u0930 \u0938\u094d\u0925\u093e\u0928 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902','Check In Time':'\u0906\u0917\u092e\u0928 \u0938\u092e\u092f','Check In Location':'\u0906\u0917\u092e\u0928 \u0938\u094d\u0925\u093e\u0928','Not available':'\u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902','Checkout Disabled':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u092c\u0902\u0926 \u0939\u0948','Office Out is pending HOD approval.':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0939\u0947\u0924\u0941 \u0932\u0902\u092c\u093f\u0924 \u0939\u0948\u0964','You have checked out successfully!':'\u0906\u092a\u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u092f\u093e!','Check-Out failed':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e','Something went wrong while checking out.':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0908\u0964','PROCESSING...':'\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u091c\u093e\u0930\u0940 \u0939\u0948...','CHECK IN':'\u0906\u0917\u092e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','CHECK OUT':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Mark your check in':'\u0905\u092a\u0928\u093e \u0906\u0917\u092e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Mark your check out':'\u0905\u092a\u0928\u093e \u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Office Out approval pending':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0932\u0902\u092c\u093f\u0924 \u0939\u0948','OFFICE OUT':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930','OFFICE IN':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0935\u093e\u092a\u0938\u0940','Leaving from office':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902','Arrived at office':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0932\u094c\u091f \u0906\u090f','PAID LEAVE':'\u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936','Apply for paid leave':'\u0935\u0947\u0924\u0928 \u0938\u0939\u093f\u0924 \u0905\u0935\u0915\u093e\u0936 \u0939\u0947\u0924\u0941 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902','URGENT LEAVE':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936','Apply for urgent leave':'\u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0939\u0947\u0924\u0941 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902',"Today's Date":'\u0906\u091c \u0915\u0940 \u0924\u093e\u0930\u0940\u0916','Office Out Pending':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0932\u0902\u092c\u093f\u0924','Office Out request is pending HOD approval.':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0939\u0947\u0924\u0941 \u0932\u0902\u092c\u093f\u0924 \u0939\u0948\u0964','Employee Attendance Status':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0938\u094d\u0925\u093f\u0924\u093f','Employee Attendance':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f','Employee History':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0907\u0924\u093f\u0939\u093e\u0938','All Employee Attendance List':'\u0938\u092d\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0942\u091a\u0940','Please select one option given below':'\u0915\u0943\u092a\u092f\u093e \u0928\u0940\u091a\u0947 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u090f\u0915 \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u0947\u0902','Company holiday calendar and notes.':'\u0915\u0902\u092a\u0928\u0940 \u091b\u0941\u091f\u094d\u091f\u0940 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0914\u0930 \u0928\u094b\u091f\u094d\u0938\u0964','No holidays found':'\u0915\u094b\u0908 \u091b\u0941\u091f\u094d\u091f\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940','Select Username':'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u091a\u0941\u0928\u0947\u0902','Select User':'\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091a\u0941\u0928\u0947\u0902','Tracking details of all employees':'\u0938\u092d\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0940 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u091c\u093e\u0928\u0915\u093e\u0930\u0940','Enter Employee Name':'\u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',SEARCH:'\u0916\u094b\u091c\u0947\u0902','Check In session':'\u0906\u0917\u092e\u0928 \u0938\u0924\u094d\u0930','Check Out session':'\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0938\u0924\u094d\u0930',Session:'\u0938\u0924\u094d\u0930',Result:'\u092a\u0930\u093f\u0923\u093e\u092e','Log Entry':'\u0932\u0949\u0917 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f',Time:'\u0938\u092e\u092f',Final:'\u0905\u0902\u0924\u093f\u092e',Note:'\u091f\u093f\u092a\u094d\u092a\u0923\u0940','On Duty':'\u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930','No record found for this date':'\u0907\u0938 \u0924\u093e\u0930\u0940\u0916 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e','Please record your Office In status once you return to the premises.':'\u092a\u0930\u093f\u0938\u0930 \u092e\u0947\u0902 \u0932\u094c\u091f\u0928\u0947 \u092a\u0930 \u0905\u092a\u0928\u0940 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0935\u093e\u092a\u0938\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964','OFFICE IN REQUEST':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0935\u093e\u092a\u0938\u0940 \u0905\u0928\u0941\u0930\u094b\u0927','You are at':'\u0906\u092a \u092f\u0939\u093e\u0901 \u0939\u0948\u0902','HOD Approval Required':'\u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915','Office In successfully recorded':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0935\u093e\u092a\u0938\u0940 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u0908','Failed to record Office In':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0935\u093e\u092a\u0938\u0940 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940','Something went wrong':'\u0915\u0941\u091b \u0917\u0932\u0924 \u0939\u094b \u0917\u092f\u093e','Please write your reason below for going outside the office.':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u0947\u0902\u0964',Official:'\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915','OFFICE OUT REQUEST':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0905\u0928\u0941\u0930\u094b\u0927','Please write your reason....':'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0932\u093f\u0916\u0947\u0902...','Please enter your reason':'\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902','Location Required':'\u0938\u094d\u0925\u093e\u0928 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948','Please wait until current location is fetched.':'\u0915\u0943\u092a\u092f\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0924\u0915 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964','Office Out request sent for HOD approval':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0939\u0947\u0924\u0941 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e','Failed to record Office Out':'\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u092c\u093e\u0939\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e','Choose the leave workflow you want to start.':'\u091c\u093f\u0938 \u0905\u0935\u0915\u093e\u0936 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u093e \u0939\u0948, \u0909\u0938\u0947 \u091a\u0941\u0928\u0947\u0902\u0964','Submit a same-day emergency leave request.':'\u0909\u0938\u0940 \u0926\u093f\u0928 \u0915\u093e \u0906\u092a\u093e\u0924 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c\u0947\u0902\u0964','Plan and track regular leave requests.':'\u0928\u093f\u092f\u092e\u093f\u0924 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u092c\u0928\u093e\u090f\u0902 \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u0947\u0916\u0947\u0902\u0964','Request leave while travelling outstation.':'\u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0925\u093e\u0928 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0935\u0915\u093e\u0936 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0947\u0902\u0964'},p=function(e){var t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:2,n=String(e||'').replace(/\s+/g,' ').trim();return n?n.split(' ').slice(0,t).map(function(e){return e.charAt(0).toUpperCase()+e.slice(1).toLowerCase()}).join(' '):'User'},y={aa:'\u0906',ai:'\u0910',au:'\u0914',a:'\u0905',ee:'\u0908',ii:'\u0908',oo:'\u090a',uu:'\u090a',e:'\u090f',i:'\u0907',o:'\u0913',u:'\u0909'},h={aa:'\u093e',ai:'\u0948',au:'\u094c',a:'',ee:'\u0940',ii:'\u0940',oo:'\u0942',uu:'\u0942',e:'\u0947',i:'\u093f',o:'\u094b',u:'\u0941'},v={ksh:'\u0915\u094d\u0937',chh:'\u091b',kh:'\u0916',gh:'\u0918',ch:'\u091a',jh:'\u091d',th:'\u0925',dh:'\u0927',ph:'\u092b',bh:'\u092d',sh:'\u0936',gn:'\u091c\u094d\u091e',tr:'\u0924\u094d\u0930',k:'\u0915',g:'\u0917',c:'\u0915',j:'\u091c',t:'\u0924',d:'\u0926',n:'\u0928',p:'\u092a',b:'\u092c',m:'\u092e',y:'\u092f',r:'\u0930',l:'\u0932',v:'\u0935',w:'\u0935',s:'\u0938',h:'\u0939',f:'\u092b',z:'\u091c'},C={sadhana:'\u0938\u093e\u0927\u0928\u093e',aman:'\u0905\u092e\u0928',amit:'\u0905\u092e\u093f\u0924',ankit:'\u0905\u0902\u0915\u093f\u0924',anita:'\u0905\u0928\u0940\u0924\u093e',pooja:'\u092a\u0942\u091c\u093e',puja:'\u092a\u0942\u091c\u093e',rahul:'\u0930\u093e\u0939\u0941\u0932',rohit:'\u0930\u094b\u0939\u093f\u0924',rishi:'\u090b\u0937\u093f',ravi:'\u0930\u0935\u093f',raj:'\u0930\u093e\u091c',raju:'\u0930\u093e\u091c\u0942',sanjay:'\u0938\u0902\u091c\u092f',deepak:'\u0926\u0940\u092a\u0915',vikash:'\u0935\u093f\u0915\u093e\u0938',vikas:'\u0935\u093f\u0915\u093e\u0938',vishal:'\u0935\u093f\u0936\u093e\u0932',sunil:'\u0938\u0941\u0928\u0940\u0932',manoj:'\u092e\u0928\u094b\u091c',neha:'\u0928\u0947\u0939\u093e',pandey:'\u092a\u093e\u0902\u0921\u0947',panday:'\u092a\u093e\u0902\u0921\u0947',pandeya:'\u092a\u093e\u0902\u0921\u0947',nisha:'\u0928\u093f\u0936\u093e',priya:'\u092a\u094d\u0930\u093f\u092f\u093e',priyanka:'\u092a\u094d\u0930\u093f\u092f\u0902\u0915\u093e',shivam:'\u0936\u093f\u0935\u092e',shubham:'\u0936\u0941\u092d\u092e',saurabh:'\u0938\u094c\u0930\u092d',sandeep:'\u0938\u0902\u0926\u0940\