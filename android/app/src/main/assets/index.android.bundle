od night':'\u0917\u0941\u0921 \u0928\u093e\u0907\u091f',GoodNight:'\u0917\u0941\u0921 \u0928\u093e\u0907\u091f',Continue:'\u0915\u0902\u091f\u093f\u0928\u094d\u092f\u0942',Back:'\u092c\u0948\u0915',Cancel:'\u0915\u0948\u0902\u0938\u093f\u0932',Retry:'\u0930\u0940\u091f\u094d\u0930\u093e\u0908',Send:'\u0938\u0947\u0902\u0921',Add:'\u0910\u0921',SAVE:'\u0938\u0947\u0935',RESET:'\u0930\u0940\u0938\u0947\u091f',SEARCH:'\u0938\u0930\u094d\u091a',SEND:'\u0938\u0947\u0902\u0921','SEND OTP':'\u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c\u094b','VERIFY OTP':'\u0913\u091f\u0940\u092a\u0940 \u0935\u0947\u0930\u0940\u092b\u093e\u0908 \u0915\u0930\u094b','RESEND OTP':'\u0913\u091f\u0940\u092a\u0940 \u0926\u094b\u092c\u093e\u0930\u093e \u092d\u0947\u091c\u094b',RESEND:'\u0926\u094b\u092c\u093e\u0930\u093e \u092d\u0947\u091c\u094b','Employee Code':'\u090f\u092e\u094d\u092a\u094d\u0932\u0949\u092f\u0940 \u0915\u094b\u0921','Phone Number':'\u092b\u094b\u0928 \u0928\u0902\u092c\u0930','Terms & Conditions':'\u091f\u0930\u094d\u092e\u094d\u0938 \u090f\u0902\u0921 \u0915\u0902\u0921\u0940\u0936\u0928\u094d\u0938','I Agree':'\u0906\u0908 \u090f\u0917\u094d\u0930\u0940','Need assistance? Contact support':'\u0939\u0947\u0932\u094d\u092a \u091a\u093e\u0939\u093f\u090f? \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0915\u0949\u0928\u094d\u091f\u0948\u0915\u094d\u091f \u0915\u0930\u094b','Crewcam Service Menu':'\u0915\u094d\u0930\u0942\u0915\u0948\u092e \u0938\u0930\u094d\u0935\u093f\u0938 \u092e\u0947\u0928\u094d\u092f\u0942','Attendance Management':'\u0905\u091f\u0947\u0902\u0921\u0947\u0902\u0938 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f','Leave Management':'\u0932\u0940\u0935 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f','Meeting & Site Visit':'\u092e\u0940\u091f\u093f\u0902\u0917 \u090f\u0902\u0921 \u0938\u093e\u0907\u091f \u0935\u093f\u091c\u093f\u091f','Manage meetings, MoMs and site visits from one place.':'\u092e\u0940\u091f\u093f\u0902\u0917\u094d\u0938, \u090f\u092e\u0913\u090f\u092e \u0914\u0930 \u0938\u093e\u0907\u091f \u0935\u093f\u091c\u093f\u091f\u094d\u0938 \u090f\u0915 \u092a\u094d\u0932\u0947\u0938 \u0938\u0947 \u092e\u0948\u0928\u0947\u091c \u0915\u0930\u094b.','Employee Live Tracking':'\u090f\u092e\u094d\u092a\u094d\u0932\u0949\u092f\u0940 \u0932\u093e\u0907\u0935 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917',Tracking:'\u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917','Master Eye':'\u092e\u093e\u0938\u094d\u091f\u0930 \u0906\u0908','Choose Action':'\u090f\u0915\u094d\u0936\u0928 \u091a\u0942\u091c \u0915\u0930\u094b','Daily Attendance':'\u0921\u0947\u0932\u0940 \u0905\u091f\u0947\u0902\u0921\u0947\u0902\u0938','Attendance Status':'\u0905\u091f\u0947\u0902\u0921\u0947\u0902\u0938 \u0938\u094d\u091f\u0947\u091f\u0938','Leave Request':'\u0932\u0940\u0935 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f','Add New Meeting':'\u0928\u094d\u092f\u0942 \u092e\u0940\u091f\u093f\u0902\u0917 \u0910\u0921 \u0915\u0930\u094b','Scheduled Meeting':'\u0936\u0947\u0921\u094d\u092f\u0942\u0932\u094d\u0921 \u092e\u0940\u091f\u093f\u0902\u0917',"Create MoM's":'\u090f\u092e\u0913\u090f\u092e \u0915\u094d\u0930\u093f\u090f\u091f \u0915\u0930\u094b','Meeting History':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940','Select Meeting Type':'\u092e\u0940\u091f\u093f\u0902\u0917 \u091f\u093e\u0907\u092a \u0938\u0947\u0932\u0947\u0915\u094d\u091f \u0915\u0930\u094b','Local Meeting':'\u0932\u094b\u0915\u0932 \u092e\u0940\u091f\u093f\u0902\u0917','Outstation Meeting':'\u0906\u0909\u091f\u0938\u094d\u091f\u0947\u0936\u0928 \u092e\u0940\u091f\u093f\u0902\u0917','Add Meeting Details':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0921\u093f\u091f\u0947\u0932\u094d\u0938 \u0910\u0921 \u0915\u0930\u094b','Meeting Date':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0921\u0947\u091f','Meeting Time':'\u092e\u0940\u091f\u093f\u0902\u0917 \u091f\u093e\u0907\u092e','Meeting Agenda':'\u092e\u0940\u091f\u093f\u0902\u0917 \u090f\u091c\u0947\u0902\u0921\u093e','Meeting History & MoM List':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u090f\u0902\u0921 \u090f\u092e\u0913\u090f\u092e \u0932\u093f\u0938\u094d\u091f','Scheduled Meeting List':'\u0936\u0947\u0921\u094d\u092f\u0942\u0932\u094d\u0921 \u092e\u0940\u091f\u093f\u0902\u0917 \u0932\u093f\u0938\u094d\u091f','No meeting history found.':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940.','No meetings scheduled for today.':'\u0906\u091c \u0915\u094b\u0908 \u092e\u0940\u091f\u093f\u0902\u0917 \u0936\u0947\u0921\u094d\u092f\u0942\u0932\u094d\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948.','No upcoming meetings scheduled.':'\u0905\u092a\u0915\u092e\u093f\u0902\u0917 \u092e\u0940\u091f\u093f\u0902\u0917 \u0936\u0947\u0921\u094d\u092f\u0942\u0932\u094d\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948.','Meeting details not found.':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0921\u093f\u091f\u0947\u0932\u094d\u0938 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940.','Meeting saved successfully.':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0938\u0915\u094d\u0938\u0947\u0938\u092b\u0941\u0932\u0940 \u0938\u0947\u0935 \u0939\u094b \u0917\u0908.','Outstation meeting saved successfully.':'\u0906\u0909\u091f\u0938\u094d\u091f\u0947\u0936\u0928 \u092e\u0940\u091f\u093f\u0902\u0917 \u0938\u0915\u094d\u0938\u0947\u0938\u092b\u0941\u0932\u0940 \u0938\u0947\u0935 \u0939\u094b \u0917\u0908.','Failed to save meeting':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0938\u0947\u0935 \u0928\u0939\u0940\u0902 \u0939\u094b \u092a\u093e\u0908','Meeting updated successfully.':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0938\u0915\u094d\u0938\u0947\u0938\u092b\u0941\u0932\u0940 \u0905\u092a\u0921\u0947\u091f \u0939\u094b \u0917\u0908.','Meeting deleted successfully.':'\u092e\u0940\u091f\u093f\u0902\u0917 \u0938\u0915\u094d\u0938\u0947\u0938\u092b\u0941\u0932\u0940 \u0921\u093f\u0932\u0940\u091f \u0939\u094b \u0917\u0908.','View previous meetings and MoM records.':'\u092a\u094d\u0930\u0940\u0935\u093f\u092f\u0938 \u092e\u0940\u091f\u093f\u0902\u0917 \u090f\u0902\u0921 \u090f\u092e\u0913\u090f\u092e \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u094d\u0938 \u0926\u0947\u0916\u094b.','Add Site Visit':'\u0938\u093e\u0907\u091f \u0935\u093f\u091c\u093f\u091f \u0910\u0921 \u0915\u0930\u094b','Log a site visit with location and purpose.':'\u0932\u094b\u0915\u0947\u0936\u0928 \u0914\u0930 \u092a\u0930\u094d\u092a\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u0907\u091f \u0935\u093f\u091c\u093f\u091f \u0932\u0949\u0917 \u0915\u0930\u094b.',Office:'\u0911\u092b\u093f\u0938',Personal:'\u092a\u0930\u094d\u0938\u0928\u0932',Account:'\u0905\u0915\u093e\u0909\u0902\u091f',Score:'\u0938\u094d\u0915\u094b\u0930','Full Name':'\u092b\u0941\u0932 \u0928\u0947\u092e','Unique ID':'\u092f\u0942\u0928\u093f\u0915 \u0906\u0908\u0921\u0940','Designation & Grade':'\u0921\u0947\u091c\u093f\u0917\u094d\u0928\u0947\u0936\u0928 \u090f\u0902\u0921 \u0917\u094d\u0930\u0947\u0921',Department:'\u0921\u093f\u092a\u093e\u0930\u094d\u091f\u092e\u0947\u0902\u091f',Name:'\u0928\u0947\u092e',Relation:'\u0930\u093f\u0932\u0947\u0936\u0928',Email:'\u0908\u092e\u0947\u0932',Date:'\u0921\u0947\u091f',Time:'\u091f\u093e\u0907\u092e',Status:'\u0938\u094d\u091f\u0947\u091f\u0938',Pending:'\u092a\u0947\u0902\u0921\u093f\u0902\u0917',Completed:'\u0915\u0902\u092a\u094d\u0932\u0940\u091f\u0947\u0921',Overdue:'\u0913\u0935\u0930\u0921\u094d\u092f\u0942','In Progress':'\u0907\u0928 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u0947\u0938',Resolved:'\u0930\u093f\u091c\u0949\u0932\u094d\u0935\u094d\u0921','Check In':'\u091a\u0947\u0915 \u0907\u0928','Check Out':'\u091a\u0947\u0915 \u0906\u0909\u091f','Office In':'\u0911\u092b\u093f\u0938 \u0907\u0928','Office Out':'\u0911\u092b\u093f\u0938 \u0906\u0909\u091f','Urgent Leave':'\u0905\u0930\u094d\u091c\u0947\u0902\